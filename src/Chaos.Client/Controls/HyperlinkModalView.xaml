<UserControl x:Class="Chaos.Client.Controls.HyperlinkModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" Width="400"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="24">
            <TextBlock Text="INSERT LINK" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,20" />

            <TextBlock Text="URL" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <TextBox Style="{StaticResource DarkTextBox}"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"
                     FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" />

            <TextBlock Text="DISPLAY TEXT" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Leave blank to insert the URL as-is"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,6" />
            <TextBox Style="{StaticResource DarkTextBox}"
                     Text="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DarkButton}"
                        Command="{Binding Cancel}"
                        Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Insert" Style="{StaticResource AccentButton}"
                        Command="{Binding Confirm}"
                        IsDefault="True" Padding="16,8" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
