<UserControl x:Class="Chaos.Client.Controls.DeleteChannelModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" Width="360"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="24">
            <TextBlock Text="DELETE CHANNEL" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource AccentRedBrush}"
                       Margin="0,0,0,12" />
            <TextBlock Text="{Binding Message}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14" TextWrapping="Wrap"
                       Margin="0,0,0,24" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DarkButton}"
                        Command="{Binding Cancel}"
                        Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Delete" Style="{StaticResource DangerButton}"
                        Command="{Binding Confirm}"
                        Padding="16,8" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
