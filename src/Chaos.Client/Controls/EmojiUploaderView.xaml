<UserControl x:Class="Chaos.Client.Controls.EmojiUploaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Chaos.Client.Converters"
             xmlns:vm="clr-namespace:Chaos.Client.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" Width="780"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="24">
            <TextBlock Text="UPLOAD CUSTOM EMOJI" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,16" />

            <DockPanel>
                <!-- Right panel: preview + name + controls -->
                <DockPanel DockPanel.Dock="Right" Width="210" Margin="24,0,0,0">
                    <!-- Buttons docked to bottom, centered -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Cancel" Style="{StaticResource DarkButton}"
                                Command="{Binding Cancel}"
                                Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="Upload" Style="{StaticResource AccentButton}"
                                Command="{Binding Confirm}"
                                IsDefault="True" Padding="16,8" />
                    </StackPanel>

                    <!-- Top content fills remaining space -->
                    <StackPanel>
                        <TextBlock Text="PREVIEW" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />

                        <!-- Preview at chat sizes: 48px standalone, 32px inline -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#20FFFFFF" CornerRadius="4" Padding="4" Margin="0,0,12,0">
                                <Image x:Name="Preview48" Source="{Binding PreviewImage}"
                                       Width="48" Height="48" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border Background="#20FFFFFF" CornerRadius="4" Padding="4"
                                    VerticalAlignment="Center">
                                <Image x:Name="Preview32" Source="{Binding PreviewImage}"
                                       Width="32" Height="32" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </StackPanel>

                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   Margin="0,0,0,12">
                            <Run Text=":" /><Run Text="{Binding EmojiName, Mode=OneWay}" /><Run Text=":" />
                        </TextBlock>

                        <TextBlock Text="EMOJI NAME" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding EmojiName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

                        <TextBlock Text="Drag to position, scroll to zoom"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <!-- Error message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF5555"
                                   FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,0,8" />
                    </StackPanel>
                </DockPanel>

                <!-- Left panel: editor canvas (500x500) -->
                <Border Width="500" Height="500" ClipToBounds="True"
                        Background="#1A1A1A" CornerRadius="4">
                    <Grid x:Name="EditorCanvas">
                        <!-- Checkerboard behind the crop area -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="256" Height="256">
                            <Border.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#2A2A2A">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,16,16" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#333333">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,8,8" />
                                                        <RectangleGeometry Rect="8,8,8,8" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                        </Border>

                        <!-- Source image with transforms -->
                        <Image x:Name="SourceImageElement" Source="{Binding SourceImage}" Stretch="None"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                                    <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Darkened overlay with transparent center crop window -->
                        <!-- Canvas=500, Crop=256, margin=(500-256)/2=122 -->
                        <Canvas IsHitTestVisible="False">
                            <!-- Top -->
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="500" Height="122" Fill="#80000000" />
                            <!-- Bottom -->
                            <Rectangle Canvas.Left="0" Canvas.Top="378" Width="500" Height="122" Fill="#80000000" />
                            <!-- Left -->
                            <Rectangle Canvas.Left="0" Canvas.Top="122" Width="122" Height="256" Fill="#80000000" />
                            <!-- Right -->
                            <Rectangle Canvas.Left="378" Canvas.Top="122" Width="122" Height="256" Fill="#80000000" />
                        </Canvas>

                        <!-- Crop bounding box outline -->
                        <Rectangle Width="256" Height="256"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stroke="#80FFFFFF" StrokeThickness="1"
                                   StrokeDashArray="4 2"
                                   IsHitTestVisible="False" />

                        <!-- Transparent hit-test surface for mouse events -->
                        <Rectangle Fill="Transparent"
                                   MouseLeftButtonDown="EditorCanvas_MouseLeftButtonDown"
                                   MouseMove="EditorCanvas_MouseMove"
                                   MouseLeftButtonUp="EditorCanvas_MouseLeftButtonUp"
                                   MouseWheel="EditorCanvas_MouseWheel"
                                   Cursor="SizeAll" />
                    </Grid>
                </Border>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
