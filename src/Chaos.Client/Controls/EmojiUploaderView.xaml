<UserControl x:Class="Chaos.Client.Controls.EmojiUploaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Chaos.Client.Converters"
             xmlns:vm="clr-namespace:Chaos.Client.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Outer border background = left panel color; CornerRadius draws it rounded natively -->
    <Border CornerRadius="12" Width="820" Background="#2A2A2A"
            BorderBrush="#30FFFFFF" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Clip geometry applied in code-behind SizeChanged to enforce rounded corners on children -->
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: single flat Grid, all layers stacked -->
            <Grid Grid.Column="0" x:Name="EditorCanvas" MinHeight="500" ClipToBounds="True">
                <!-- Checkerboard covers entire left panel -->
                <Grid.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#3A3A3A">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,16,16" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#2A2A2A">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,8,8" />
                                            <RectangleGeometry Rect="8,8,8,8" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>

                <!-- Gradient panels over checkerboard (below overlay) -->
                <Border VerticalAlignment="Top" Height="54">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2A2A2A" Offset="0" />
                            <GradientStop Color="#002A2A2A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border VerticalAlignment="Bottom" Height="40">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#002A2A2A" Offset="0" />
                            <GradientStop Color="#2A2A2A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Source image with transforms -->
                <Image x:Name="SourceImageElement" Source="{Binding SourceImage}" Stretch="None"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- Dim overlay covering entire left panel with 256x256 center hole -->
                <Grid IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="256" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="256" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Fill="#50000000" />
                    <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Fill="#50000000" />
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#50000000" />
                    <Rectangle Grid.Row="1" Grid.Column="2" Fill="#50000000" />
                </Grid>

                <!-- Crop bounding box — solid white border -->
                <Rectangle Width="256" Height="256"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stroke="White" StrokeThickness="1.5"
                           IsHitTestVisible="False" />

                <!-- Header text ON TOP of overlay -->
                <Grid VerticalAlignment="Top" Height="54" IsHitTestVisible="False">
                    <Button Command="{Binding Cancel}" Cursor="Hand"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="14,0,0,0" Width="30" Height="30" IsHitTestVisible="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="4">
                                    <TextBlock Text="&#x2715;" FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Add Emoji" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Hint text ON TOP of overlay -->
                <TextBlock Text="Drag to reposition or scroll to zoom"
                           Foreground="#80FFFFFF" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,12" IsHitTestVisible="False" />

                <!-- Transparent hit-test surface for mouse events -->
                <Rectangle Fill="Transparent"
                           MouseLeftButtonDown="EditorCanvas_MouseLeftButtonDown"
                           MouseMove="EditorCanvas_MouseMove"
                           MouseLeftButtonUp="EditorCanvas_MouseLeftButtonUp"
                           MouseWheel="EditorCanvas_MouseWheel"
                           Cursor="SizeAll" />
            </Grid>

            <!-- Right panel -->
            <Border Grid.Column="1" Background="{StaticResource BgDarkBrush}">
                <DockPanel Margin="24,20">
                    <!-- Upload button at bottom, full width -->
                    <Button DockPanel.Dock="Bottom" Content="Upload"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding Confirm}"
                            IsDefault="True" Padding="16,10"
                            HorizontalAlignment="Stretch"
                            Margin="0,12,0,0" />

                    <StackPanel>
                        <TextBlock Text="Preview" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Preview images in dark boxes -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="{StaticResource BgDarkestBrush}" CornerRadius="6"
                                    Padding="16" Margin="0,0,12,0">
                                <Image x:Name="Preview48" Source="{Binding PreviewImage}"
                                       Width="48" Height="48" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border Background="{StaticResource BgDarkestBrush}" CornerRadius="6"
                                    Padding="12" VerticalAlignment="Top">
                                <Image x:Name="Preview32" Source="{Binding PreviewImage}"
                                       Width="64" Height="64" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </StackPanel>

                        <!-- Emoji name label with required asterisk -->
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8">
                            <Run Text="Emoji name " Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="*" Foreground="#FF5555" />
                        </TextBlock>

                        <!-- Name input with focus highlight -->
                        <Border Background="{StaticResource BgInputBrush}" CornerRadius="4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox Text="{Binding EmojiName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" Padding="8,6" FontSize="14" />
                        </Border>

                        <!-- :name: preview -->
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,8,0,0">
                            <Run Text=":" /><Run Text="{Binding EmojiName, Mode=OneWay}" /><Run Text=":" />
                        </TextBlock>

                        <Border Height="8" />

                        <!-- Error message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF5555"
                                   FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
